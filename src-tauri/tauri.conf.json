{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TruongFlix",
  "version": "2.0.0",
  "identifier": "com.iantruong.truongflix",
  "build": {
    "beforeDevCommand": "npm run bundle:trailers && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run bundle:trailers && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "TruongFlix",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#141414",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https://image.tmdb.org data: blob:; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* https://api.themoviedb.org https://www.omdbapi.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://iant4093.github.io http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/frames/**",
          "$APPCACHE/live-artwork/**",
          "$APPCACHE/game-images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "bin/yt-dlp",
      "bin/deno"
    ],
    "resources": {
      "bin/licenses/": "trailer-licenses/",
      "resources/source-filters/": "source-filters/"
    },
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "Local media center with a Netflix-style UI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent File",
        "description": "BitTorrent Metainfo File",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OEU3OUFFQzM4NzQ3N0MKUldSOFI0ZkRybm1PdHloTEcwMFAzMTZJVGJuN3phMk10TG5HS085WFRJQ3pxN3hPcjFJMHN3VHMK",
      "endpoints": [
        "https://github.com/iant4093/TruongFlix/releases/latest/download/latest.json"
      ]
    }
  }
}
